# Telegram API — https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Бот уведомлений — токен от @BotFather
BOT_TOKEN=

# Отклики пишет Antigravity CLI (agy), вход через Google в терминале: agy
# Необязательно: полный путь к agy.exe, если не в PATH.
# AGY_BIN=

# Старый ключ Cursor больше не нужен для откликов.
# CURSOR_API_KEY=

# Jev / TypeSafe — оценка заявок на этапе отбора (System One).
# Ключ из https://console.typesafe.ai (или панель, где заводил аккаунт).
# Достаточно одного из двух имён:
JEV_API_KEY=
# TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Старый запасной LLM (сейчас для оценки не обязателен).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Необязательно. Если пусто, рейтинг чатов TGStat не спрашивает.
# TGSTAT_TOKEN=

HOST=127.0.0.1
PORT=8787
